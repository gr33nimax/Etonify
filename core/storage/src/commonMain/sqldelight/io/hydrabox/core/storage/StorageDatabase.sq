selectAll:
SELECT * FROM settings;

upsertSetting:
INSERT OR REPLACE INTO settings(setting_key, value, secret_value) VALUES (?, ?, ?);

selectSecretValue:
SELECT secret_value FROM settings WHERE setting_key = ?;

selectValue:
SELECT value FROM storage_metadata WHERE storage_key = ?;

selectMetadata:
SELECT * FROM storage_metadata ORDER BY storage_key;

upsertValue:
INSERT OR REPLACE INTO storage_metadata(storage_key, value) VALUES (?, ?);

selectSubscriptions:
SELECT * FROM subscriptions ORDER BY subscription_id;

selectSubscriptionSecret:
SELECT source_secret FROM subscriptions WHERE subscription_id = ?;

upsertSubscription:
INSERT OR REPLACE INTO subscriptions(subscription_id, name, source_secret, updated_at_millis) VALUES (?, ?, ?, ?);

deleteAllSettings:
DELETE FROM settings;

deleteAllMetadata:
DELETE FROM storage_metadata;

deleteAllSubscriptions:
DELETE FROM subscriptions;

deleteSubscription:
DELETE FROM subscriptions WHERE subscription_id = ?;

appendJournal:
INSERT INTO journal(kind, at_millis, level, area, message) VALUES (?, ?, ?, ?, ?);

selectJournal:
SELECT at_millis, level, area, message FROM journal ORDER BY id;

trimJournal:
DELETE FROM journal
WHERE kind = :kind
  AND id <= (SELECT MAX(id) FROM journal WHERE kind = :kind) - :keep;

clearJournal:
DELETE FROM journal;

deleteMetadataWithPrefix:
DELETE FROM storage_metadata WHERE storage_key LIKE :prefix ESCAPE '\';

deleteSetting:
DELETE FROM settings WHERE setting_key = ?;
