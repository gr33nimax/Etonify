<?xml version="1.0" encoding="utf-8"?>
<!--
  The two languages the app is translated into. Declaring them lets Android 13 and later
  offer a per-app language in system settings, which is where a person expects to find it.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
</locale-config>
