<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The database holds subscription documents whose secret fields
  are sealed with a key that lives in the keystore and is not backed up, so a restored copy
  would be unreadable anyway — but the names, addresses and settings beside them are not
  nothing, and a cloud backup is not a place a person expects them to be. 1.x excluded the
  same four domains; the alpha shipped no rules at all, which means the platform default of
  backing everything up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
